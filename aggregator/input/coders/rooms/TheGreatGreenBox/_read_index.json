 10, "items": 5, "chars": 467, "words": 81, "title": "Wardens of the Core: protect our center!", "head": [17616, 17711], "body": [17789, 18472], "has_window": false}, {"tid": "62muaa", "n": 11, "items": 4, "chars": 237, "words": 42, "title": "You know what we have to do...", "head": [18550, 18635], "body": [18713, 19182], "has_window": false}, {"tid": "62mun8", "n": 12, "items": 2, "chars": 57, "words": 9, "title": "I accidentally", "head": [19260, 19327], "body": [19405, 19600], "has_window": false}, {"tid": "62mups", "n": 13, "items": 4, "chars": 278, "words": 50, "title": "ALL HAIL THE GREAT GREEN BOX", "head": [19678, 19761], "body": [19839, 20310], "has_window": false}, {"tid": "62mzyh", "n": 14, "items": 2, "chars": 91, "words": 16, "title": "We just attempt a takeover of the Top Right Corner.", "head": [20388, 20493], "body": [20571, 20757], "has_window": false}, {"tid": "62n00d", "n": 15, "items": 1, "chars": 29, "words": 6, "title": "THE GREAT GREEN BOX LIVE CHAT", "head": [20835, 20917], "body": [20995, 21167], "has_window": false}, {"tid": "62n135", "n": 16, "items": 1, "chars": 40, "words": 5, "title": "Make Hogwarts into Slytherin!", "head": [21245, 21327], "body": [21405, 21496], "has_window": false}, {"tid": "62n3yu", "n": 17, "items": 6, "chars": 842, "words": 152, "title": "Position on the Grid around 983/315", "head": [21574, 22282], "body": [22360, 23477], "has_window": true}, {"tid": "62n9d5", "n": 18, "items": 8, "chars": 605, "words": 113, "title": "THE RED IS INFECTING US!", "head": [23555, 24252], "body": [24330, 25348], "has_window": true}, {"tid": "62nh13", "n": 19, "items": 1, "chars": 84, "words": 16, "title": "Build here to cut off red. Also need green lines to direct to build spot.", "head": [25426, 25553], "body": [25631, 25810], "has_window": false}, {"tid": "62nh18", "n": 20, "items": 1, "chars": 110, "words": 19, "title": "If we focus on the bottom left corner, we can gain solidify ourselves as the most important colour.", "head": [