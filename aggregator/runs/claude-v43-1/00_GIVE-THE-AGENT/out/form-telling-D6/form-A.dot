digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="Form A, Border terms and the announced plan: its changes against the global model (D6a-11 to D6a-16)", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work"];
    K02 [label="K02: the room judges it has too few hands"];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration\nspecifies by add-step (21 rooms)\nT3-043 crediting who made the work; T4-026 Completion ritual; D07\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P12 [label="P12: records (after hour 73, curation of the record)\nspecifies by add-step (16 rooms)\nT3-073 reporting how the work fared; T4-027 Collective memory; D07\nSIZE-DEPENDENT", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2, color="#555555"];
    P13 [label="P13: what the room keeps"];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter"];
    P01 [label="P01: the room's calls for hands"];
    P02 [label="P02: settling what the mark will show"];
    P03 [label="P03: building the mark, members posting its state"];
    P04 [label="P04: templates and coordinates\nspecifies by add-step (32 rooms)\nT3-070 sharing coordinates, templates and how-to; T4-008 Standardization of output; D02\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P05 [label="P05: upkeep\nspecifies by add-condition, link (37 rooms)\nT3-009 celebrating the finished work; T4-013 Repair work; D03\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P07 [label="P07: sparing a neighbour's work\nspecifies by add-condition (16 rooms)\nT3-005 defending the work against attackers; T4-013 Repair work; D03\nSIZE-DEPENDENT", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2, color="#555555"];
    P08 [label="P08: border talk and deals\nspecifies by add-step, link, add-condition (21 rooms)\nT3-010 settling borders with neighbours; T4-016 Negotiated order; D04\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P09 [label="P09: attack calls"];
    P10 [label="P10: the move"];
    P14 [label="P14: scripts and spare accounts\nrestricts by restrict (17 rooms)\nT3-027 arguing whether scripts are fair; T4-009 Workarounds; D02\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P15 [label="P15: the bare answer"];
    P16 [label="P16: help between rooms"];
    P17 [label="P17: coalitions"];
    P18 [label="P18: contest in talk"];
    P20 [label="P20: the host sub's line"];
    P23 [label="P23: the chat\nspecifies by add-step (16 rooms)\nT3-014 moving planning into a chat; T4-010 Backstage decision-making; D02\nSIZE-DEPENDENT", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2, color="#555555"];
  }
  subgraph cluster_claims { label="Claims beside the model"; style=rounded; color="#cccccc";
    C01 [label="C01: decided order\nrestricts by restrict (17 rooms)\nT3-010 settling borders with neighbours; T4-016 Negotiated order; D04\nSIZE-DEPENDENT", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2, color="#555555"];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01 N01"];
  R01 -> P01 [label="A02 N01"];
  P03 -> P05 [label="A03 N01"];
  P05 -> P08 [label="A04 N02"];
  P08 -> P07 [label="A05 N09\nrestricts (39)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P05 -> P14 [label="A06 N06"];
  P03 -> P11 [label="A07 N04"];
  P11 -> P12 [label="A08 N04"];
  P12 -> P13 [label="A09 N04"];
  K02 -> P10 [label="A10 N08"];
  P02 -> P04 [label="A11 N07"];
  P01 -> P15 [label="A12 N07"];
  P05 -> P16 [label="A13 N02"];
  P08 -> P16 [label="A14 N09\nrestricts (15)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P01 -> P09 [label="A15 N03"];
  P09 -> P07 [label="A16 N03"];
  P09 -> P08 [label="A17 N03"];
  P09 -> P18 [label="A18 N03"];
  P05 -> P17 [label="A19 N02"];
  P01 -> P20 [label="A20 N05"];
  subgraph cluster_legend { label="Legend"; style=rounded; color="#cccccc";
    lg1 [label="ROBUST: keeps its relation at ratio 1.5 and floor 15 per cent", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3];
    lg2 [label="MARGINAL: leans only at the rule's thresholds", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2];
    lg3 [label="SIZE-DEPENDENT: does not keep its lean with record size held fixed", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2];
    lg4 [label="unchanged by the form: held as the model states it"];
    lg5 [shape=note, fillcolor="#ffffff", label="The form's fourth-order change signature:\lT4-016 Negotiated order (D04): changed by 87% of the form's defining rooms, 1.75 times the population\lT4-026 Completion ritual (D07): changed by 51% of the form's defining rooms, 1.58 times the population\lT4-008 Standardization of output (D02): changed by 37% of the form's defining rooms, 2.06 times the population\l"];
    lg1 -> lg2 -> lg3 -> lg4 -> lg5 [style=invis];
  }
}
