digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/dwarffortress (form B, Behind the thread: chat, scripts, raids): the global model as instantiated in this room", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work\nabsent", style="rounded,dashed", color="#999999"];
    K02 [label="K02: the room judges it has too few hands\ncarried as stated", fillcolor="#d9f0d3"];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration\ncarried as stated", fillcolor="#d9f0d3"];
    P12 [label="P12: records (after hour 73, curation of the record)\nchange in the ledger view, not selected", fillcolor="#fee8c8", style="rounded,filled,dashed"];
    P13 [label="P13: what the room keeps\nabsent", style="rounded,dashed", color="#999999"];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter\ncarried as stated", fillcolor="#d9f0d3"];
    P01 [label="P01: the room's calls for hands\ncarried as stated", fillcolor="#d9f0d3"];
    P02 [label="P02: settling what the mark will show\ncarried as stated", fillcolor="#d9f0d3"];
    P03 [label="P03: building the mark, members posting its state\ncarried as stated", fillcolor="#d9f0d3"];
    P04 [label="P04: templates and coordinates\nadd-condition (T3-107 keeping planning in the thread)", fillcolor="#fdb863", penwidth=1, color="#999999"];
    P05 [label="P05: upkeep\nlink (T3-107 keeping planning in the thread)\nrestrict (T3-107 keeping planning in the thread)\nadd-condition (T3-021 watching and repairing the work)", fillcolor="#fdb863", penwidth=1, color="#999999"];
    P07 [label="P07: sparing a neighbour's work\ncarried as stated", fillcolor="#d9f0d3"];
    P08 [label="P08: border talk and deals\ncarried as stated", fillcolor="#d9f0d3"];
    P09 [label="P09: attack calls\nchange in the ledger view, not selected", fillcolor="#fee8c8", style="rounded,filled,dashed"];
    P10 [label="P10: the move\nabsent", style="rounded,dashed", color="#999999"];
    P14 [label="P14: scripts and spare accounts\ncarried as stated", fillcolor="#d9f0d3"];
    P15 [label="P15: the bare answer\ncarried as stated", fillcolor="#d9f0d3"];
    P16 [label="P16: help between rooms\ncarried as stated", fillcolor="#d9f0d3"];
    P17 [label="P17: coalitions\ncarried as stated", fillcolor="#d9f0d3"];
    P18 [label="P18: contest in talk\ncarried as stated", fillcolor="#d9f0d3"];
    P20 [label="P20: the host sub's line\ncarried as stated", fillcolor="#d9f0d3"];
    P23 [label="P23: the chat\nadd-condition (T3-107 keeping planning in the thread)\nadd-step (T3-014 moving planning into a chat)\nFORM B CHANGE", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    P25 [label="P25: newcomers through the work\nadd-condition (T3-014 moving planning into a chat)\nadd-step (T3-107 keeping planning in the thread)", fillcolor="#fdb863", penwidth=1, color="#999999"];
    P34 [label="P34: turning on the room's own mark\nadd-condition (T3-075 objecting to the canvas flood)", fillcolor="#fdb863", penwidth=1, color="#999999"];
  }
  subgraph cluster_claims { label="Claims beside the model"; style=rounded; color="#cccccc";
    C02 [label="C02: a prior tie names the rival\nrestrict (T3-135 telling clashes as fandom lore)", fillcolor="#fdb863", penwidth=1, color="#999999"];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01", color="#dddddd", fontcolor="#bbbbbb"];
  R01 -> P01 [label="A02 N01\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P03 -> P05 [label="A03 N01\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P05 -> P08 [label="A04 N02\nholds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
  P08 -> P07 [label="A05 N09\nholds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
  P05 -> P14 [label="A06 N06\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P03 -> P11 [label="A07", color="#dddddd", fontcolor="#bbbbbb"];
  P11 -> P12 [label="A08 N04\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P12 -> P13 [label="A09 absent", style=dotted, color="#999999", fontcolor="#999999"];
  K02 -> P10 [label="A10 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P02 -> P04 [label="A11 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P01 -> P15 [label="A12 N07\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P05 -> P16 [label="A13 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P08 -> P16 [label="A14 N09\nledger view: add-condition, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P01 -> P09 [label="A15", color="#dddddd", fontcolor="#bbbbbb"];
  P09 -> P07 [label="A16", color="#dddddd", fontcolor="#bbbbbb"];
  P09 -> P08 [label="A17 N03\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P09 -> P18 [label="A18", color="#dddddd", fontcolor="#bbbbbb"];
  P05 -> P17 [label="A19 N02\nledger view: add-condition, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P01 -> P20 [label="A20 N05\nadd-condition", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  subgraph cluster_legend { label="Legend"; style=rounded; color="#cccccc";
    k1 [label="carried as stated (instantiated, no change)", fillcolor="#d9f0d3"];
    k2 [label="changed by the room: op (T3 where the change sits)", fillcolor="#fdb863"];
    k3 [label="changed, and one of form B's defining changes", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    k4 [label="absent from the record", style="rounded,dashed"];
    k5 [label="no line in the ledger", fontcolor="#999999", color="#dddddd"];
    k6 [shape=plaintext, fillcolor="#ffffff", label="arrows: green holds; red dashed changed; grey dotted absent"];
    k1 -> k2 -> k3 -> k4 -> k5 -> k6 [style=invis];
  }
}
