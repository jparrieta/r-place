digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/bardmains (form C, The design reopened): the global model as instantiated in this room", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work\nchange in the ledger view, not selected", fillcolor="#fee8c8", style="rounded,filled,dashed"];
    K02 [label="K02: the room judges it has too few hands\ncarried as stated", fillcolor="#d9f0d3"];
    K07 [label="K07: members of both rooms\nadd-condition (T3-010 settling borders with neighbours)", fillcolor="#fdb863", penwidth=1, color="#999999"];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration\ncarried as stated", fillcolor="#d9f0d3"];
    P12 [label="P12: records (after hour 73, curation of the record)\ncarried as stated", fillcolor="#d9f0d3"];
    P13 [label="P13: what the room keeps\nadd-condition (T3-054 carrying work to new canvases)", fillcolor="#fdb863", penwidth=1, color="#999999"];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter\ncarried as stated", fillcolor="#d9f0d3"];
    P01 [label="P01: the room's calls for hands\ncarried as stated", fillcolor="#d9f0d3"];
    P02 [label="P02: settling what the mark will show\nadd-step (T3-002 calling members in to place)\nadd-condition (T3-004 settling the mark's design)\nFORM C CHANGE", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    P03 [label="P03: building the mark, members posting its state\ncarried as stated", fillcolor="#d9f0d3"];
    P04 [label="P04: templates and coordinates\ncarried as stated", fillcolor="#d9f0d3"];
    P05 [label="P05: upkeep\nrestrict (T3-004 settling the mark's design)\nFORM C CHANGE", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    P07 [label="P07: sparing a neighbour's work\ncarried as stated", fillcolor="#d9f0d3"];
    P08 [label="P08: border talk and deals\ncarried as stated", fillcolor="#d9f0d3"];
    P09 [label="P09: attack calls\nabsent", style="rounded,dashed", color="#999999"];
    P10 [label="P10: the move\nabsent", style="rounded,dashed", color="#999999"];
    P14 [label="P14: scripts and spare accounts\nno line", fontcolor="#999999", color="#dddddd"];
    P15 [label="P15: the bare answer\ncarried as stated", fillcolor="#d9f0d3"];
    P16 [label="P16: help between rooms\nadd-condition (T3-005 defending the work against attacke)", fillcolor="#fdb863", penwidth=1, color="#999999"];
    P17 [label="P17: coalitions\nabsent", style="rounded,dashed", color="#999999"];
    P18 [label="P18: contest in talk\nchange in the ledger view, not selected", fillcolor="#fee8c8", style="rounded,filled,dashed"];
    P20 [label="P20: the host sub's line\nadd-step (T3-015 routing canvas posts into megathre)", fillcolor="#fdb863", penwidth=1, color="#999999"];
    P23 [label="P23: the chat\nadd-condition (T3-015 routing canvas posts into megathre)", fillcolor="#fdb863", penwidth=1, color="#999999"];
    P33 [label="P33: plans kept from rivals\nrestrict (T3-005 defending the work against attacke)", fillcolor="#fdb863", penwidth=1, color="#999999"];
  }
  subgraph cluster_claims { label="Claims beside the model"; style=rounded; color="#cccccc";
    C01 [label="C01: decided order\nadd-condition (T3-015 routing canvas posts into megathre)", fillcolor="#fdb863", penwidth=1, color="#999999"];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01 N01\nholds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
  R01 -> P01 [label="A02 N01\nledger view: restrict, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P03 -> P05 [label="A03 N01\nholds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
  P05 -> P08 [label="A04 N02\nholds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
  P08 -> P07 [label="A05 N09\nrestrict", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P05 -> P14 [label="A06 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P03 -> P11 [label="A07", color="#dddddd", fontcolor="#bbbbbb"];
  P11 -> P12 [label="A08 N04\nrestrict", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P12 -> P13 [label="A09 N04\nrestrict", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  K02 -> P10 [label="A10 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P02 -> P04 [label="A11 N07\nrestrict\nFORM C CHANGE", color="#d7191c", fontcolor="#d7191c", penwidth=3, style=dashed];
  P01 -> P15 [label="A12 N07\nrestrict", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P05 -> P16 [label="A13 N02\nrestrict\nFORM C CHANGE", color="#d7191c", fontcolor="#d7191c", penwidth=3, style=dashed];
  P08 -> P16 [label="A14 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P01 -> P09 [label="A15 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P09 -> P07 [label="A16 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P09 -> P08 [label="A17 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P09 -> P18 [label="A18 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P05 -> P17 [label="A19 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P01 -> P20 [label="A20", color="#dddddd", fontcolor="#bbbbbb"];
  subgraph cluster_legend { label="Legend"; style=rounded; color="#cccccc";
    k1 [label="carried as stated (instantiated, no change)", fillcolor="#d9f0d3"];
    k2 [label="changed by the room: op (T3 where the change sits)", fillcolor="#fdb863"];
    k3 [label="changed, and one of form C's defining changes", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    k4 [label="absent from the record", style="rounded,dashed"];
    k5 [label="no line in the ledger", fontcolor="#999999", color="#dddddd"];
    k6 [shape=plaintext, fillcolor="#ffffff", label="arrows: green holds; red dashed changed; grey dotted absent"];
    k1 -> k2 -> k3 -> k4 -> k5 -> k6 [style=invis];
  }
}
