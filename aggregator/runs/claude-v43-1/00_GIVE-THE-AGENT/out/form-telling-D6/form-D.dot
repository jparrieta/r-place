digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="Form D, Keeping, with help or carrying on: its changes against the global model (D6a-11 to D6a-16)", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work\nspecifies by add-step (24 rooms)\nT3-001 staging April Fools fake news; T4-001 Keying; D06\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    K02 [label="K02: the room judges it has too few hands"];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration\nspecifies by add-step (15 rooms)\nT3-009 celebrating the finished work; T4-026 Completion ritual; D07\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P12 [label="P12: records (after hour 73, curation of the record)"];
    P13 [label="P13: what the room keeps\nspecifies by add-step, add-condition (24 rooms)\nT3-054 carrying work to new canvases; T4-028 Transition; D07\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter"];
    P01 [label="P01: the room's calls for hands\nspecifies by link (16 rooms)\nT3-054 carrying work to new canvases; T4-028 Transition; D07\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P02 [label="P02: settling what the mark will show"];
    P03 [label="P03: building the mark, members posting its state"];
    P04 [label="P04: templates and coordinates"];
    P05 [label="P05: upkeep\nspecifies by add-step (21 rooms)\nT3-021 watching and repairing the work; T4-013 Repair work; D03\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P07 [label="P07: sparing a neighbour's work\nspecifies by add-condition (12 rooms)\nT3-010 settling borders with neighbours; T4-015 Live and let live; D04\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P08 [label="P08: border talk and deals"];
    P09 [label="P09: attack calls"];
    P10 [label="P10: the move"];
    P14 [label="P14: scripts and spare accounts\nrestricts by restrict (15 rooms)\nT3-027 arguing whether scripts are fair; T4-009 Workarounds; D02\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P15 [label="P15: the bare answer"];
    P16 [label="P16: help between rooms\nspecifies by add-condition (19 rooms)\nT3-011 helping another room's work; T4-017 Reciprocity; D04\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P17 [label="P17: coalitions"];
    P18 [label="P18: contest in talk"];
    P20 [label="P20: the host sub's line\nspecifies by add-step (15 rooms)\nT3-090 opening a canvas sub; T4-002 Boundary work; D06\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P19 [label="P19: a guest's work under a host's rule\nrestricts by restrict (11 rooms)\nT3-010 settling borders with neighbours; T4-016 Negotiated order; D04\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01 N01\nrestricts (19)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  R01 -> P01 [label="A02 N01\nrestricts (12)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P03 -> P05 [label="A03 N01"];
  P05 -> P08 [label="A04 N02"];
  P08 -> P07 [label="A05 N09\nspecifies (13)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P05 -> P14 [label="A06 N06\nrestricts (21)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P03 -> P11 [label="A07 N04"];
  P11 -> P12 [label="A08 N04"];
  P12 -> P13 [label="A09 N04\nrestricts (16)\nROBUST", color="#e66101", fontcolor="#e66101", penwidth=3, style=solid];
  K02 -> P10 [label="A10 N08"];
  P02 -> P04 [label="A11 N07"];
  P01 -> P15 [label="A12 N07"];
  P05 -> P16 [label="A13 N02\nrestricts (33)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P08 -> P16 [label="A14 N09"];
  P01 -> P09 [label="A15 N03"];
  P09 -> P07 [label="A16 N03"];
  P09 -> P08 [label="A17 N03"];
  P09 -> P18 [label="A18 N03"];
  P05 -> P17 [label="A19 N02"];
  P01 -> P20 [label="A20 N05\nrestricts (10)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  subgraph cluster_legend { label="Legend"; style=rounded; color="#cccccc";
    lg1 [label="ROBUST: keeps its relation at ratio 1.5 and floor 15 per cent", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3];
    lg2 [label="MARGINAL: leans only at the rule's thresholds", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2];
    lg3 [label="SIZE-DEPENDENT: does not keep its lean with record size held fixed", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2];
    lg4 [label="unchanged by the form: held as the model states it"];
    lg5 [shape=note, fillcolor="#ffffff", label="The form's fourth-order change signature:\lT4-013 Repair work (D03): changed by 74% of the form's defining rooms, 1.82 times the population\lT4-028 Transition (D07): changed by 41% of the form's defining rooms, 2.22 times the population\lT4-017 Reciprocity (D04): changed by 38% of the form's defining rooms, 2.49 times the population\l"];
    lg1 -> lg2 -> lg3 -> lg4 -> lg5 [style=invis];
  }
}
