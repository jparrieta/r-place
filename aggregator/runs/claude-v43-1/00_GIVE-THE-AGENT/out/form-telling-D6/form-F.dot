digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="Form F, Moving for the spot: its changes against the global model (D6a-11 to D6a-16)", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work\nspecifies by add-step (9 rooms)\nT3-001 staging April Fools fake news; T4-001 Keying; D06\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    K02 [label="K02: the room judges it has too few hands"];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration"];
    P12 [label="P12: records (after hour 73, curation of the record)\nspecifies by link (5 rooms)\nT3-016 explaining what the canvas is; T4-014 Territoriality; D04\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P13 [label="P13: what the room keeps"];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter"];
    P01 [label="P01: the room's calls for hands\nspecifies by link (6 rooms)\nT3-038 building and reporting the mark; T4-014 Territoriality; D04\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P02 [label="P02: settling what the mark will show"];
    P03 [label="P03: building the mark, members posting its state\nspecifies by link (12 rooms)\nT3-022 relocating after losing the spot; T4-014 Territoriality; D04\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P04 [label="P04: templates and coordinates\nspecifies by add-step, link (9 rooms)\nT3-039 yielding space when asked; T4-014 Territoriality; D04\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P05 [label="P05: upkeep\nspecifies by add-step (7 rooms)\nT3-021 watching and repairing the work; T4-013 Repair work; D03\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P07 [label="P07: sparing a neighbour's work"];
    P08 [label="P08: border talk and deals"];
    P09 [label="P09: attack calls"];
    P10 [label="P10: the move"];
    P14 [label="P14: scripts and spare accounts\nspecifies by add-step (6 rooms)\nT3-028 running scripts for the work; T4-009 Workarounds; D02\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
    P15 [label="P15: the bare answer"];
    P16 [label="P16: help between rooms"];
    P17 [label="P17: coalitions"];
    P18 [label="P18: contest in talk"];
    P20 [label="P20: the host sub's line"];
    P19 [label="P19: a guest's work under a host's rule\nrestricts by restrict (6 rooms)\nT3-035 asking a host for space; T4-014 Territoriality; D04\nROBUST", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3, color="#555555"];
    P27 [label="P27: choosing the spot before any loss\nrestricts by restrict (5 rooms)\nT3-022 relocating after losing the spot; T4-014 Territoriality; D04\nMARGINAL", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2, color="#555555"];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01 N01"];
  R01 -> P01 [label="A02 N01"];
  P03 -> P05 [label="A03 N01"];
  P05 -> P08 [label="A04 N02\nrestricts (13)\nROBUST", color="#e66101", fontcolor="#e66101", penwidth=3, style=solid];
  P08 -> P07 [label="A05 N09"];
  P05 -> P14 [label="A06 N06\nrestricts (9)\nROBUST", color="#e66101", fontcolor="#e66101", penwidth=3, style=solid];
  P03 -> P11 [label="A07 N04\nrestricts (7)\nROBUST", color="#e66101", fontcolor="#e66101", penwidth=3, style=solid];
  P11 -> P12 [label="A08 N04"];
  P12 -> P13 [label="A09 N04"];
  K02 -> P10 [label="A10 N08\nrestricts (16)\nMARGINAL", color="#f1a340", fontcolor="#f1a340", penwidth=3, style=dashed];
  P02 -> P04 [label="A11 N07"];
  P01 -> P15 [label="A12 N07\nrestricts (10)\nSIZE-DEPENDENT", color="#8073ac", fontcolor="#8073ac", penwidth=3, style=dotted];
  P05 -> P16 [label="A13 N02"];
  P08 -> P16 [label="A14 N09"];
  P01 -> P09 [label="A15 N03"];
  P09 -> P07 [label="A16 N03"];
  P09 -> P08 [label="A17 N03"];
  P09 -> P18 [label="A18 N03"];
  P05 -> P17 [label="A19 N02"];
  P01 -> P20 [label="A20 N05"];
  subgraph cluster_legend { label="Legend"; style=rounded; color="#cccccc";
    lg1 [label="ROBUST: keeps its relation at ratio 1.5 and floor 15 per cent", style="rounded,filled,bold", fillcolor="#e66101", penwidth=3];
    lg2 [label="MARGINAL: leans only at the rule's thresholds", style="rounded,filled,dashed", fillcolor="#fdb863", penwidth=2];
    lg3 [label="SIZE-DEPENDENT: does not keep its lean with record size held fixed", style="rounded,filled,dotted", fillcolor="#d8daeb", penwidth=2];
    lg4 [label="unchanged by the form: held as the model states it"];
    lg5 [shape=note, fillcolor="#ffffff", label="The form's fourth-order change signature:\lT4-014 Territoriality (D04): changed by 94% of the form's defining rooms, 5.36 times the population\lT4-005 Mobilization (D01): changed by 44% of the form's defining rooms, 1.67 times the population\lthe link Repair work > Negotiated order: changed by 41% of the form's defining rooms, 1.55 times the population\l"];
    lg1 -> lg2 -> lg3 -> lg4 -> lg5 [style=invis];
  }
}
