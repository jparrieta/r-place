{
 "elements": [
  {
   "id": "P01",
   "kind": "process",
   "statement": "The room calls its own members, and kindred subs, to come and place for a work: to start it, build it, finish it or hold it.",
   "tier": [
    "T4-005"
   ],
   "dimension": [
    "D01"
   ]
  },
  {
   "id": "P02",
   "kind": "process",
   "statement": "The room settles what its mark will show of it: a member proposes a picture, the room argues its design, makes its land's flag or emblems the mark, signs it or leaves it unsigned, claims a mark others made, adds to it or enlarges it, or adds a personal piece to a shared mark.",
   "tier": [
    "T4-006"
   ],
   "dimension": [
    "D02"
   ]
  },
  {
   "id": "P03",
   "kind": "process",
   "statement": "The room builds its mark, and members report its state to the thread: what is placed, done or missing, and where.",
   "tier": [
    "T4-007"
   ],
   "dimension": [
    "D02"
   ]
  },
  {
   "id": "P04",
   "kind": "process",
   "statement": "Members circulate a template that lays out the mark pixel by pixel, or coordinates that locate it, ask for them, and ask strays to keep to them.",
   "tier": [
    "T4-008"
   ],
   "dimension": [
    "D02"
   ]
  },
  {
   "id": "P05",
   "kind": "process",
   "statement": "The room keeps its placed work against erosion: members watch it and repair changed pixels, and the room rallies to defend it under attack, covers the night, hardens its shape and puts upkeep before growth.",
   "tier": [
    "T4-013"
   ],
   "dimension": [
    "D03"
   ]
  },
  {
   "id": "P06",
   "kind": "process",
   "statement": "Members work out who changed their work and why: they trace placers and rooms, find friendly fire or their own mistake, blame officers, or disown placers acting in their name.",
   "tier": [
    "T4-019"
   ],
   "dimension": [
    "D03"
   ]
  },
  {
   "id": "P07",
   "kind": "process",
   "statement": "Rooms spare their neighbours' work, rein in their own attackers, apologise for damage and appeal to attackers to stop.",
   "tier": [
    "T4-015"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "P08",
   "kind": "process",
   "statement": "Rooms propose, settle and contest borders, truces and deals with neighbours by talk, through envoys, and hold each other to them.",
   "tier": [
    "T4-016"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "P09",
   "kind": "process",
   "statement": "Rooms attack others' work by the recurring moves the canvas affords: erasing, encroaching, converting a sign, raiding on a streamer's call, planting a script, altering a work as a joke.",
   "tier": [
    "T4-020"
   ],
   "dimension": [
    "D08"
   ]
  },
  {
   "id": "P10",
   "kind": "process",
   "statement": "After the work is erased or overrun, the room weighs fighting for the spot against moving, and moves: a new spot, a smaller version, a fresh start.",
   "tier": [
    "T3-022",
    "T3-124"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "P11",
   "kind": "process",
   "statement": "When a work is up, the room marks it: announces it, celebrates it, credits makers and helpers, reports members' own parts and says what working with strangers meant.",
   "tier": [
    "T4-026"
   ],
   "dimension": [
    "D07"
   ]
  },
  {
   "id": "P12",
   "kind": "process",
   "statement": "The room records what happened to its work and to the canvas around it: screenshots and timelapses, reports of its fate, mourning, imagined art, atlas entries, the end marked.",
   "tier": [
    "T4-027"
   ],
   "dimension": [
    "D07"
   ]
  },
  {
   "id": "P13",
   "kind": "process",
   "statement": "Near the close and after it, the room decides what of its temporary effort to keep: a later canvas, a new purpose for its canvas sub, the mark in its banner, ties with other rooms, the work remade elsewhere.",
   "tier": [
    "T4-028"
   ],
   "dimension": [
    "D07"
   ]
  },
  {
   "id": "P14",
   "kind": "process",
   "statement": "Members add placements with scripts, bots and spare accounts, and the room argues over these machine hands and adjusts them.",
   "tier": [
    "T4-009"
   ],
   "dimension": [
    "D02"
   ]
  },
  {
   "id": "P15",
   "kind": "process",
   "statement": "A member answers a call or proposal in one line that joins, assents, reports a part done or thanks, and the line asks for nothing back.",
   "tier": [
    "FP-01"
   ],
   "dimension": []
  },
  {
   "id": "K01",
   "kind": "condition",
   "statement": "The host sub is keyed as play for April Fools: members post fakes and takeovers under the one-day licence, and a claim in it, a call to the canvas included, may be a joke.",
   "tier": [
    "T4-001"
   ],
   "dimension": [
    "D06"
   ]
  },
  {
   "id": "K02",
   "kind": "condition",
   "statement": "The room judges that it has too few hands or too little room for the work it wants: doubt, a canvas judged too full, a work judged absent or outclassed.",
   "tier": [
    "T4-012"
   ],
   "dimension": [
    "D01"
   ]
  },
  {
   "id": "C01",
   "kind": "claim",
   "statement": "Most rooms worked on their marks without deciding how they were organized: a decided element of order (a leader, a vote, an oath, a sanction, a division of the work) is coded in 46 of 705 rooms (F-006).",
   "tier": [
    "T4-011",
    "FP-08"
   ],
   "dimension": [
    "D02"
   ]
  },
  {
   "id": "R01",
   "kind": "role",
   "statement": "The starter: a member who proposes the mark, maps it or begins placing it, and whom others then join.",
   "tier": [
    "T3-033",
    "T3-092"
   ],
   "dimension": [
    "D02"
   ]
  },
  {
   "id": "R02",
   "kind": "role",
   "statement": "The envoy: a member who acts for a room toward another room, carrying a proposal between threads or chats.",
   "tier": [
    "T3-194"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "P16",
   "kind": "process",
   "statement": "Rooms help one another's works and trade help: they give pixels to a neighbour's mark, ask other rooms for help, barter help for space or repair, thank their allies, greet them, and turn requests away.",
   "tier": [
    "T4-017"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "P17",
   "kind": "process",
   "statement": "Rooms join other rooms in coalitions: they meet in shared chats, form alliances, gather kindred rooms in a hub, tally kindred rooms' works and make joint marks.",
   "tier": [
    "T4-018"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "P18",
   "kind": "process",
   "statement": "Rooms carry a contest with a rival room in talk: they trade taunts, flood the rival's threads, claim victory, salute the rival after the fight and blame attackers after the close.",
   "tier": [
    "T4-021"
   ],
   "dimension": [
    "D08"
   ]
  },
  {
   "id": "K03",
   "kind": "condition",
   "statement": "The community carries a quarrel from before the canvas into it: a rival sub, a sports or national rivalry, an old dispute.",
   "tier": [
    "T3-086"
   ],
   "dimension": [
    "D05"
   ]
  },
  {
   "id": "P20",
   "kind": "process",
   "statement": "The host sub draws a line around canvas talk: moderators gather it into a megathread, remove canvas posts by rule, change posting rules, pause the sub's usual events or disown the work; members open a canvas sub, object to the flood or argue the canvas's worth.",
   "tier": [
    "T4-002"
   ],
   "dimension": [
    "D06"
   ]
  },
  {
   "id": "K04",
   "kind": "condition",
   "statement": "The room acts as a body it was before the canvas, or as a faith in a colour: it argues the nation's history, belonging and politics beyond its flag, carries in the sub's quarrel, lore, jokes or ideology, or professes and spreads a colour.",
   "tier": [
    "T4-022",
    "T4-023",
    "T4-004"
   ],
   "dimension": [
    "D05"
   ]
  },
  {
   "id": "P19",
   "kind": "process",
   "statement": "One room's work lives on another room's mark or territory under the host's rule: guests ask for space or protection, hosts rule on requests, and both sides dispute who may approve.",
   "tier": [
    "T3-035",
    "T3-094",
    "T3-099",
    "T3-162"
   ],
   "dimension": [
    "D04"
   ]
  },
  {
   "id": "C02",
   "kind": "claim",
   "statement": "In some rooms, a tie the room had before the canvas (a league or school rivalry, a nation's history, an ideology, lore) names the rival in the same turn that calls for or carries out the attack.",
   "tier": [
    "T4-020",
    "T4-021",
    "T4-022",
    "T4-004"
   ],
   "dimension": [
    "D08",
    "D05"
   ]
  },
  {
   "id": "P21",
   "kind": "process",
   "statement": "Members dispute who may commit the room to an agreement with other rooms: they say that one member's agreement does not bind every placer, deny that a treaty speaks for them, or ask another group for a leader to deal with.",
   "tier": [
    "T3-126"
   ],
   "dimension": [
    "D04"
   ],
   "status": "tentative"
  },
  {
   "id": "P22",
   "kind": "process",
   "statement": "After placement ends, members contest which version of the canvas and of the event is kept: they ask a cleanup of a shared copy to fix their work, take part in it, argue that the cleanup should keep the damage as history, and correct accounts of the event that describe their group wrongly.",
   "tier": [
    "T4-027"
   ],
   "dimension": [
    "D07"
   ],
   "status": "tentative"
  }
 ],
 "arrows": [
  {
   "id": "A01",
   "kind": "order",
   "from": "P01",
   "to": "P03",
   "mechanism": "The room's call brings members to the canvas, who then build the mark and say how far it has come."
  },
  {
   "id": "A02",
   "kind": "order",
   "from": "R01",
   "to": "P01",
   "mechanism": "A member who proposes or begins a mark gives the room something to answer, and calls for hands gather around it."
  },
  {
   "id": "A03",
   "kind": "order",
   "from": "P03",
   "to": "P05",
   "mechanism": "Once a mark stands on a surface anyone can change, keeping it becomes the work: a finished part is something to lose."
  },
  {
   "id": "A04",
   "kind": "order",
   "from": "P05",
   "to": "P08",
   "mechanism": "Keeping a mark against erosion brings the room up against the neighbours whose pixels erode it, and the room turns to talk with them."
  },
  {
   "id": "A05",
   "kind": "order",
   "from": "P08",
   "to": "P07",
   "mechanism": "A settled border gives the room a line to keep: members spare the neighbour's work by it and remind others of it."
  },
  {
   "id": "A06",
   "kind": "order",
   "from": "P05",
   "to": "P14",
   "mechanism": "Upkeep under attack outruns what one pixel per interval can hold, and members turn to scripts and spare accounts to keep up."
  },
  {
   "id": "A07",
   "kind": "order",
   "from": "P03",
   "to": "P11",
   "mechanism": "A mark reported done gives the room a finished thing to point at, and the room marks it together: announcement, credit, pride."
  },
  {
   "id": "A08",
   "kind": "order",
   "from": "P11",
   "to": "P12",
   "mechanism": "Marking the work together turns the room toward keeping it: members ask for the final image, the timelapse, the list of what changed."
  },
  {
   "id": "A09",
   "kind": "order",
   "from": "P12",
   "to": "P13",
   "mechanism": "A record of the work gives the room something to carry: the image into the banner, the plan into the next canvas."
  },
  {
   "id": "A10",
   "kind": "order",
   "from": "K02",
   "to": "P10",
   "mechanism": "A room that judges it has too few hands to hold its spot stops fighting for it and moves."
  },
  {
   "id": "A11",
   "kind": "transition",
   "from": "P02",
   "to": "P04",
   "mechanism": "Design talk in a thread is settled by someone posting a template that lays out the agreed design pixel by pixel."
  },
  {
   "id": "A12",
   "kind": "transition",
   "from": "P01",
   "to": "P15",
   "mechanism": "A call is the first part of a pair: posted to a thread, it makes an answer from each reader the next thing due, given in the thread or by placing. Joining is the answer the call prefers, so it comes bare, one line that commits and gives no reason ('I'm in'); declining is the dispreferred answer and, in conversation analysis, comes with a reason. In the written record a bare join is the ordinary way a call is accepted (25 of 31 read acceptances, F-023); a member can also accept by placing and write nothing, which the record cannot show."
  },
  {
   "id": "A13",
   "kind": "order",
   "from": "P05",
   "to": "P16",
   "mechanism": "A room keeping its work under strain runs short of hands and turns to other rooms for help, and other rooms send it."
  },
  {
   "id": "A14",
   "kind": "order",
   "from": "P08",
   "to": "P16",
   "mechanism": "Talk over a border opens a channel through which the two rooms then trade help: room for upkeep, pixels for protection."
  },
  {
   "id": "A15",
   "kind": "order",
   "from": "P01",
   "to": "P09",
   "mechanism": "A call brings members to the canvas, and some of them turn its hands against a rival's work instead of, or before, building the room's own."
  },
  {
   "id": "A16",
   "kind": "order",
   "from": "P09",
   "to": "P07",
   "mechanism": "A call to attack makes an answer from the room due in its thread. Members who do not want the attack refuse it, rein in the attackers or apologise to the target; refusing is the dispreferred answer, so in written replies it usually comes with a reason (23 of 38 read pairs, F-014), and the reason states the room's norm or the attack's cost ('Nah, keep /r/place neutral.'; 'Why? That'll just cause them to want to attack us')."
  },
  {
   "id": "A17",
   "kind": "order",
   "from": "P09",
   "to": "P08",
   "mechanism": "A call to attack is met by the room's relations with its neighbours: the room invokes a truce, or proposes a deal instead."
  },
  {
   "id": "A18",
   "kind": "order",
   "from": "P09",
   "to": "P18",
   "mechanism": "An attack makes the rival a named party, and the contest is carried on in talk: taunts, chants, claims of victory, a salute after the fight."
  },
  {
   "id": "A19",
   "kind": "order",
   "from": "P05",
   "to": "P17",
   "mechanism": "A room keeping its work against attack joins other rooms whose works face the same threat, and they defend each other's works together."
  },
  {
   "id": "A20",
   "kind": "order",
   "from": "P01",
   "to": "P20",
   "mechanism": "Calls to the canvas flood the host sub, and its moderators or members answer by drawing a line around canvas talk: one thread, removals, a canvas sub."
  },
  {
   "id": "A21",
   "kind": "order",
   "from": "P08",
   "to": "P21",
   "mechanism": "An agreement made with another room in the room's name puts its members' compliance in question. Members who did not make it say that it does not bind them, or that no one can bind every placer, and the other side asks who can speak for the group.",
   "status": "tentative"
  }
 ],
