    k1 [label="carried as stated (instantiated, no change)", fillcolor="#d9f0d3"];
    k2 [label="changed by the room: op (T3 where the change sits)", fillcolor="#fdb863"];
    k3 [label="one of form E's changes, shown by the room", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    k4 [label="one of form E's changes, not shown by the room (hollow border)", fillcolor="#ffffff", peripheries=2, penwidth=1.5, color="#2c7bb6"];
