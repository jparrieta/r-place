digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/paladins (form E, The sub's play, run as work; round 2): the global model as instantiated in this room (round 2, D6a-17)", nodesep=0.25, ranksep=0.6];
