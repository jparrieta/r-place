digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/bindingofisaac (form D, Keeping, with help or carrying on; round 2, D.2.1): the global model as instantiated in this room (round 2, D6a-17)", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work\nadd-condition (T3-095 testing others' April Fools claims)\nadd-step (T3-032 objecting to April Fools posts)\nadd-step (T3-023 running an April Fools takeover)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
    K02 [label="K02: the room judges it has too few hands\ncarried as stated", fillcolor="#d9f0d3"];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P12 [label="P12: records (after hour 73, curation of the record)\ncarried as stated", fillcolor="#d9f0d3"];
    P13 [label="P13: what the room keeps\nadd-condition (T3-057 remaking canvas art elsewhere)\nadd-step (T3-054 carrying work to new canvases)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter\ncarried as stated", fillcolor="#d9f0d3"];
    P01 [label="P01: the room's calls for hands\nlink (T3-054 carrying work to new canvases)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
    P02 [label="P02: settling what the mark will show\nlink (T3-054 carrying work to new canvases)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P03 [label="P03: building the mark, members posting its state\ncarried as stated", fillcolor="#d9f0d3"];
    P04 [label="P04: templates and coordinates\ncarried as stated", fillcolor="#d9f0d3"];
    P05 [label="P05: upkeep\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P07 [label="P07: sparing a neighbour's work\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P08 [label="P08: border talk and deals\ncarried as stated", fillcolor="#d9f0d3"];
    P09 [label="P09: attack calls\ncarried as stated", fillcolor="#d9f0d3"];
    P10 [label="P10: the move\nabsent", style="rounded,dashed", color="#999999"];
    P14 [label="P14: scripts and spare accounts\nabsent\nform D cell, not shown here", style="rounded,dashed", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P15 [label="P15: the bare answer\ncarried as stated", fillcolor="#d9f0d3"];
    P16 [label="P16: help between rooms\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P17 [label="P17: coalitions\ncarried as stated", fillcolor="#d9f0d3"];
    P18 [label="P18: contest in talk\ncarried as stated", fillcolor="#d9f0d3"];
    P20 [label="P20: the host sub's line\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P06 [label="P06: working out who changed the work\nadd-condition (T3-170 mistaking friendly work for vandal)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P23 [label="P23: the chat\nrestrict (T3-170 mistaking friendly work for vandal)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P24 [label="P24: explaining the canvas\nlink (T3-002 calling members in to place)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P31 [label="P31: whether covering is fair\nrestrict (T3-073 reporting how the work fared)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P33 [label="P33: plans kept from rivals\nrestrict (T3-005 defending the work against attacke)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P19 [label="P19: a guest's work under a host's rule\nno line\nform D cell, not shown here", fontcolor="#999999", color="#2c7bb6", peripheries=2, penwidth=1.5];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01\n(form D cell, not shown here)", color="#dddddd", fontcolor="#bbbbbb"];
  R01 -> P01 [label="A02 N01\nrestrict: a condition or an overlap\nFORM D CHANGE, SHOWN", color="#d7191c", fontcolor="#d7191c", penwidth=3.5, style=dashed];
  P03 -> P05 [label="A03 N01\nrestrict: a condition or an overlap", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P05 -> P08 [label="A04 N02\nholds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
  P08 -> P07 [label="A05 N09\nadd-condition\nFORM D CHANGE, SHOWN", color="#e66101", fontcolor="#e66101", penwidth=3.5, style=dashed];
  P05 -> P14 [label="A06 absent\n(form D cell, not shown here)", style=dotted, color="#999999", fontcolor="#999999"];
  P03 -> P11 [label="A07 N04\nrestrict: the arrow fails here", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
  P11 -> P12 [label="A08", color="#dddddd", fontcolor="#bbbbbb"];
  P12 -> P13 [label="A09 N04\nrestrict: the record cannot show it\nFORM D CHANGE, SHOWN", color="#5e3c99", fontcolor="#5e3c99", penwidth=3.5, style=dotted];
  K02 -> P10 [label="A10 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P02 -> P04 [label="A11 N07\nrestrict: a condition or an overlap", color="#d7191c", fontcolor="#d7191c", penwidth=2, style=dashed];
  P01 -> P15 [label="A12 N07\nrestrict: the arrow fails here", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
  P05 -> P16 [label="A13 N02\nrestrict: the record cannot show it\nFORM D CHANGE, SHOWN", color="#5e3c99", fontcolor="#5e3c99", penwidth=3.5, style=dotted];
  P08 -> P16 [label="A14 N09\nledger view: restrict, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P01 -> P09 [label="A15 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P09 -> P07 [label="A16 N03\nrestrict: the arrow fails here", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
  P09 -> P08 [label="A17 N03\nledger view: restrict, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P09 -> P18 [label="A18 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P05 -> P17 [label="A19 N02\nrestrict: the record cannot show it", color="#5e3c99", fontcolor="#5e3c99", penwidth=2.5, style=dotted];
  P01 -> P20 [label="A20 N05\nrestrict: the record cannot show it\nFORM D CHANGE, SHOWN", color="#5e3c99", fontcolor="#5e3c99", penwidth=3.5, style=dotted];
  subgraph cluster_legend { label="Legend (round 2)"; style=rounded; color="#cccccc";
    k1 [label="carried as stated (instantiated, no change)", fillcolor="#d9f0d3"];
    k2 [label="changed by the room: op (T3 where the change sits)", fillcolor="#fdb863"];
    k3 [label="one of form D's changes, shown by the room", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    k4 [label="one of form D's changes, not shown by the room (hollow border)", fillcolor="#ffffff", peripheries=2, penwidth=1.5, color="#2c7bb6"];
    k5 [label="absent from the record", style="rounded,dashed"];
    k6 [label="no line in the ledger", fontcolor="#999999", color="#dddddd"];
    ka [label="arrows", shape=plaintext, fillcolor="#ffffff"];
    kb [label="(restricts by one reader's sort of the line, D5)", shape=plaintext, fillcolor="#ffffff"];
    ka -> kb [label="holds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
    ka -> kb [label="restrict: the arrow fails here", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
    ka -> kb [label="restrict: the record cannot show it", color="#5e3c99", fontcolor="#5e3c99", penwidth=2.5, style=dotted];
    ka -> kb [label="restrict: a condition or an overlap", color="#d7191c", fontcolor="#d7191c", style=dashed];
    ka -> kb [label="other change (add-step, add-condition, link)", color="#e66101", fontcolor="#e66101", style=dashed];
    ka -> kb [label="absent", color="#999999", fontcolor="#999999", style=dotted];
    k1 -> k2 -> k3 -> k4 -> k5 -> k6 -> ka [style=invis];
  }
}
