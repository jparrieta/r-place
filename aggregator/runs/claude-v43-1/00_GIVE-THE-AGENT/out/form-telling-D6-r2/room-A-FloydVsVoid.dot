digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/FloydVsVoid (form A, Border terms and the announced plan; the good old room): the global model as instantiated in this room (round 2, D6a-17)", nodesep=0.25, ranksep=0.6];
