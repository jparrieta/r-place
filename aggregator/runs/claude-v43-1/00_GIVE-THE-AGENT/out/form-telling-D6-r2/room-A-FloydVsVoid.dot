    P23 [label="P23: the chat\nrestrict (T3-014 moving planning into a chat)\nlink (T3-021 watching and repairing the work)\nform A cell, not shown here", fillcolor="#fdb863", color="#2c7bb6", penwidth=1.5, peripheries=2];
    P27 [label="P27: choosing the spot before any loss\nrestrict (T3-022 relocating after losing the spot)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P28 [label="P28: a room formed around a mark\nrestrict (T3-014 moving planning into a chat)", fillcolor="#fdb863", color="#999999", penwidth=1];
