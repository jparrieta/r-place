  P03 -> P05 [label="A03", color="#dddddd", fontcolor="#bbbbbb"];
  P05 -> P08 [label="A04", color="#dddddd", fontcolor="#bbbbbb"];
  P08 -> P07 [label="A05 N09\nrestrict: the arrow fails here\n(form D cell, not shown here)", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
  P05 -> P14 [label="A06 absent\n(form D cell, not shown here)", style=dotted, color="#999999", fontcolor="#999999"];
  P03 -> P11 [label="A07", color="#dddddd", fontcolor="#bbbbbb"];
  P11 -> P12 [label="A08 N04\nrestrict: the record cannot show it", color="#5e3c99", fontcolor="#5e3c99", penwidth=2.5, style=dotted];
  P12 -> P13 [label="A09 N04\nledger view: restrict, not selected\n(form D cell, not shown here)", color="#fdae61", fontcolor="#d7191c", style=dashed];
