  P02 -> P04 [label="A11 N07\nrestrict: the record cannot show it", color="#5e3c99", fontcolor="#5e3c99", penwidth=2.5, style=dotted];
  P01 -> P15 [label="A12 N07\nledger view: restrict, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P05 -> P16 [label="A13 N02\nrestrict: the record cannot show it\nFORM D CHANGE, SHOWN", color="#5e3c99", fontcolor="#5e3c99", penwidth=3.5, style=dotted];
  P08 -> P16 [label="A14 N09\nledger view: restrict, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P01 -> P09 [label="A15 N03\nrestrict: the record cannot show it", color="#5e3c99", fontcolor="#5e3c99", penwidth=2.5, style=dotted];
  P09 -> P07 [label="A16 N03\nrestrict: the arrow fails here", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
  P09 -> P08 [label="A17", color="#dddddd", fontcolor="#bbbbbb"];
  P09 -> P18 [label="A18 N03\nledger view: add-condition, not selected", color="#fdae61", fontcolor="#d7191c", style=dashed];
  P05 -> P17 [label="A19 absent", style=dotted, color="#999999", fontcolor="#999999"];
  P01 -> P20 [label="A20 N05\nledger view: restrict, not selected\n(form D cell, not shown here)", color="#fdae61", fontcolor="#d7191c", style=dashed];
  subgraph cluster_legend { label="Legend (round 2)"; style=rounded; color="#cccccc";
    k1 [label="carried as stated (instantiated, no change)", fillcolor="#d9f0d3"];
    k2 [label="changed by the room: op (T3 where the change sits)", fillcolor="#fdb863"];
    k3 [label="one of form D's changes, shown by the room", fillcolor="#fdb863", penwidth=3, color="#2c7bb6"];
    k4 [label="one of form D's changes, not shown by the room (hollow border)", fillcolor="#ffffff", peripheries=2, penwidth=1.5, color="#2c7bb6"];
    k5 [label="absent from the record", style="rounded,dashed"];
    k6 [label="no line in the ledger", fontcolor="#999999", color="#dddddd"];
    ka [label="arrows", shape=plaintext, fillcolor="#ffffff"];
    kb [label="(restricts by one reader's sort of the line, D5)", shape=plaintext, fillcolor="#ffffff"];
    ka -> kb [label="holds", color="#1a9641", fontcolor="#1a9641", penwidth=2];
    ka -> kb [label="restrict: the arrow fails here", color="#b2182b", fontcolor="#b2182b", penwidth=2.5, style=bold];
    ka -> kb [label="restrict: the record cannot show it", color="#5e3c99", fontcolor="#5e3c99", penwidth=2.5, style=dotted];
    ka -> kb [label="restrict: a condition or an overlap", color="#d7191c", fontcolor="#d7191c", style=dashed];
    ka -> kb [label="other change (add-step, add-condition, link)", color="#e66101", fontcolor="#e66101", style=dashed];
    ka -> kb [label="absent", color="#999999", fontcolor="#999999", style=dotted];
    k1 -> k2 -> k3 -> k4 -> k5 -> k6 -> ka [style=invis];
  }
}
