digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/gamindustri (form D, Keeping, with help or carrying on; the good old room): the global model as instantiated in this room (round 2, D6a-17)", nodesep=0.25, ranksep=0.6];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff", color="#999999"];
  edge [fontname="Helvetica", fontsize=8, color="#bbbbbb"];
  subgraph cluster_conditions { label="Conditions"; style=rounded; color="#cccccc";
    K01 [label="K01: the April Fools play, beside the work\nadd-condition (T3-001 staging April Fools fake news)\nform D cell, not shown here", fillcolor="#fdb863", color="#2c7bb6", penwidth=1.5, peripheries=2];
    K02 [label="K02: the room judges it has too few hands\ncarried as stated", fillcolor="#d9f0d3"];
    K04 [label="K04: the room as a body it was before\nlink (T3-005 defending the work against attacke)", fillcolor="#fdb863", color="#999999", penwidth=1];
  }
  subgraph cluster_follows { label="What follows"; style=rounded; color="#cccccc";
    P11 [label="P11: celebration\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P12 [label="P12: records (after hour 73, curation of the record)\nadd-step (T3-026 announcing the mark is up)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P13 [label="P13: what the room keeps\nadd-step (T3-054 carrying work to new canvases)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
  }
  subgraph cluster_mediators { label="Mediators: what the room and its members do"; style=rounded; color="#cccccc";
    R01 [label="R01: the starter\ncarried as stated", fillcolor="#d9f0d3"];
    P01 [label="P01: the room's calls for hands\ncarried as stated\nform D cell, not shown here", fillcolor="#d9f0d3", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P02 [label="P02: settling what the mark will show\ncarried as stated", fillcolor="#d9f0d3"];
    P03 [label="P03: building the mark, members posting its state\nlink (T3-054 carrying work to new canvases)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P04 [label="P04: templates and coordinates\nadd-condition (T3-021 watching and repairing the work)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P05 [label="P05: upkeep\nchange in the ledger view, not selected\nform D cell, not shown here", fillcolor="#fee8c8", style="rounded,filled,dashed", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P07 [label="P07: sparing a neighbour's work\nadd-condition (T3-041 extending the room's work)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
    P08 [label="P08: border talk and deals\ncarried as stated", fillcolor="#d9f0d3"];
    P09 [label="P09: attack calls\ncarried as stated", fillcolor="#d9f0d3"];
    P10 [label="P10: the move\nabsent", style="rounded,dashed", color="#999999"];
    P14 [label="P14: scripts and spare accounts\nabsent\nform D cell, not shown here", style="rounded,dashed", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P15 [label="P15: the bare answer\ncarried as stated", fillcolor="#d9f0d3"];
    P16 [label="P16: help between rooms\nadd-condition (T3-151 bartering help with neighbours)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
    P17 [label="P17: coalitions\nabsent", style="rounded,dashed", color="#999999"];
    P18 [label="P18: contest in talk\ncarried as stated", fillcolor="#d9f0d3"];
    P20 [label="P20: the host sub's line\nchange in the ledger view, not selected\nform D cell, not shown here", fillcolor="#fee8c8", style="rounded,filled,dashed", color="#2c7bb6", peripheries=2, penwidth=1.5];
    P19 [label="P19: a guest's work under a host's rule\nadd-step (T3-035 asking a host for space)\nrestrict (T3-035 asking a host for space)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
    P23 [label="P23: the chat\nrestrict (T3-035 asking a host for space)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P31 [label="P31: whether covering is fair\nrestrict (T3-154 claiming victory over rival rooms)", fillcolor="#fdb863", color="#999999", penwidth=1];
    P19 [label="P19: a guest's work under a host's rule\nadd-step (T3-035 asking a host for space)\nrestrict (T3-035 asking a host for space)\nFORM D CHANGE, SHOWN", fillcolor="#fdb863", color="#2c7bb6", penwidth=3];
  }
  H73 [label="hour 73: placement stops", shape=ellipse, fillcolor="#eeeeee"];
  P11 -> H73 [arrowhead=none, style=dotted]; H73 -> P12 [arrowhead=none, style=dotted];
  P01 -> P03 [label="A01 N01\nrestrict: the record cannot show it\nFORM D CHANGE, SHOWN", color="#5e3c99", fontcolor="#5e3c99", penwidth=3.5, style=dotted];
