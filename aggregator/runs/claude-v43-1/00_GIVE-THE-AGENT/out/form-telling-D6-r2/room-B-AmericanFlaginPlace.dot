    P18 [label="P18: contest in talk\ncarried as stated", fillcolor="#d9f0d3"];
    P20 [label="P20: the host sub's line\nchange in the ledger view, not selected", fillcolor="#fee8c8", style="rounded,filled,dashed"];
    P19 [label="P19: a guest's work under a host's rule\nadd-condition (T3-149 agreeing truces with rival rooms)", fillcolor="#fdb863", color="#999999", penwidth=1];
