digraph G {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, labelloc=t, label="r/AmericanFlaginPlace (form B, Behind the thread: chat, scripts, raids; round 2, the chat): the global model as instantiated in this room (round 2, D6a-17)", nodesep=0.25, ranksep=0.6];
